    "%@: speed and target every refresh, minimum and maximum once at launch" : {
      "comment" : "Developer Menu: In Use summary line for the fans. The argument lists fans, such as Fan 1, Fan 2.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: السرعة والمستهدف في كل تحديث، والحد الأدنى والحد الأقصى مرة واحدة عند الفتح"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: hastighed og mål ved hver opdatering, minimum og maksimum én gang ved start"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Drehzahl und Ziel bei jeder Aktualisierung, Minimum und Maximum einmal beim Start"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: velocidad y objetivo en cada actualización, mínimo y máximo una vez al abrir"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: velocidad y objetivo en cada actualización, mínimo y máximo una sola vez al iniciar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: nopeus ja tavoite jokaisella päivityksellä, minimi ja maksimi kerran käynnistyksessä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : vitesse et cible à chaque actualisation, minimum et maximum une seule fois au lancement"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : vitesse et cible à chaque actualisation, minimum et maximum une seule fois au lancement"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: מהירות ויעד בכל רענון, מינימום ומקסימום פעם אחת בעת ההפעלה"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: velocità e obiettivo a ogni aggiornamento, minimo e massimo una volta all'avvio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 速度と目標は更新のたびに、最小と最大は起動時に1回読み取ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 속도와 목표는 갱신할 때마다, 최소와 최대는 실행할 때 한 번 읽음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: hastighet og mål ved hver oppdatering, minimum og maksimum én gang ved oppstart"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: snelheid en doel bij elke verversing, minimum en maximum eenmaal bij het opstarten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: velocidade e meta a cada atualização, mínima e máxima uma vez ao abrir"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: velocidade e objetivo a cada atualização, mínimo e máximo uma vez ao abrir"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: hastighet och mål vid varje uppdatering, minimum och maximum en gång vid start"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：转速和目标转速每次刷新时读取，最小和最大转速仅在启动时读取一次"
