    "Always use dark mode, regardless of your Mac's appearance settings." : {
      "comment" : "App theme: dark appearance option caption",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام الوضع الداكن دائمًا، بغض النظر عن إعدادات مظهر Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug altid mørkt udseende, uanset udseendeindstillingerne på din Mac."
