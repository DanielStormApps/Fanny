    "Raw values in Celsius, including idle placeholders such as 0.0 that Fanny skips." : {
      "comment" : "Developer Menu: footnote under the CPU table.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيم خام بالدرجة المئوية، تشمل قيمًا بديلة خاملة مثل 0.0 يتخطاها Fanny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rå værdier i Celsius, inklusive pladsholdere for inaktive nøgler som 0.0, som Fanny springer over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rohwerte in Celsius, einschließlich Platzhaltern im Leerlauf wie 0.0, die Fanny überspringt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores sin procesar en Celsius, incluidos marcadores de inactividad como 0.0 que Fanny omite."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores sin procesar en Celsius, incluidos marcadores de posición inactivos como 0.0 que Fanny omite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raaka-arvot celsiusasteina, mukaan lukien tyhjäkäyntiarvot, kuten 0.0, jotka Fanny ohittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeurs brutes en Celsius, y compris les valeurs de repos comme 0.0 que Fanny ignore."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeurs brutes en Celsius, y compris les valeurs fictives au repos comme 0.0 que Fanny ignore."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים גולמיים בצלזיוס, כולל ערכי מילוי במצב סרק כמו 0.0 ש-Fanny מדלגת עליהם."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori grezzi in Celsius, inclusi i segnaposto inattivi come 0.0 che Fanny ignora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摂氏の生の値です。Fannyが無視する、0.0などの待機中のプレースホルダも含みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "섭씨 원시 값이며, Fanny가 건너뛰는 0.0 같은 대기 상태 자리 표시 값도 포함돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rå verdier i Celsius, inkludert plassholdere for inaktive sensorer, som 0.0, som Fanny hopper over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruwe waarden in Celsius, inclusief tijdelijke aanduidingen zoals 0.0 die Fanny overslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores brutos em Celsius, incluindo marcadores ociosos, como 0.0, que o Fanny ignora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores em bruto em Celsius, incluindo valores de repouso como 0.0 que o Fanny ignora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Råvärden i Celsius, inklusive tomgångsplatshållare som 0.0 som Fanny hoppar över."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以摄氏度显示的原始值，包括 Fanny 会跳过的空闲占位值，例如 0.0。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始攝氏值，包含 Fanny 會略過的閒置預留值，例如 0.0。"
          }
        }
      }
    },
