    "Drag cards and readings to reorder them." : {
      "comment" : "Settings footnote under the floating window's card list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب البطاقات والقراءات لإعادة ترتيبها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk kort og målinger for at ændre rækkefølgen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Karten und Messwerte, um sie neu anzuordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las tarjetas y las lecturas para reordenarlas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las tarjetas y las lecturas para reordenarlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä kortit ja lukemat uudelleen vetämällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les cartes et les relevés pour les réorganiser."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les cartes et les mesures pour les réorganiser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גררו כרטיסים וקריאות כדי לשנות את הסדר שלהם."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le schede e le letture per riordinarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードや測定値をドラッグして並べ替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드와 측정값을 드래그하여 순서를 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra kort og målinger for å endre rekkefølgen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep kaarten en metingen om ze opnieuw te ordenen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os cartões e as leituras para reordená-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os cartões e as leituras para os reordenar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra kort och avläsningar för att ändra ordning på dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移卡片和读数即可重新排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移卡片和讀數即可重新排序。"
          }
        }
      }
    },
    "Drag items to reorder them. Hover over the menu bar item to see every reading." : {
      "comment" : "Settings footnote under the list of what the menu bar shows (keep Fanny).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب العناصر لإعادة ترتيبها. مرّر المؤشر فوق عنصر شريط القوائم لرؤية كل القراءات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk emnerne for at ændre rækkefølgen. Hold markøren over symbolet i menulinjen for at se alle målinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe Einträge, um sie neu anzuordnen. Bewege den Mauszeiger über den Menüleisteneintrag, um alle Messwerte zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los elementos para reordenarlos. Pasa el puntero por el elemento de la barra de menús para ver todas las lecturas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los ítems para reordenarlos. Coloca el cursor sobre el ítem de la barra de menús para ver todas las lecturas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä kohteet uudelleen vetämällä. Näet kaikki lukemat viemällä osoittimen valikkorivin kohteen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments pour les réorganiser. Survolez l’élément de la barre des menus pour voir tous les relevés."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser les éléments pour les réorganiser. Placez le pointeur sur l’élément de la barre des menus pour voir toutes les mesures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גררו פריטים כדי לשנות את הסדר שלהם. העבירו את המצביע מעל הפריט בשורת התפריטים כדי לראות כל קריאה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina gli elementi per riordinarli. Passa il puntatore sull'elemento nella barra dei menu per vedere ogni lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目をドラッグして並べ替えます。メニューバーの項目にポインタを合わせると、すべての測定値を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목을 드래그하여 순서를 바꿀 수 있어요. 메뉴 막대 항목 위에 포인터를 올리면 모든 측정값을 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra objekter for å endre rekkefølgen. Hold pekeren over menylinjeobjektet for å se alle målinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep onderdelen om ze opnieuw te ordenen. Beweeg de aanwijzer over het onderdeel in de menubalk om alle metingen te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os itens para reordená-los. Passe o ponteiro sobre o item da barra de menus para ver todas as leituras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste os itens para os reordenar. Passe o cursor sobre o item da barra de menus para ver todas as leituras."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra objekt för att ändra ordning på dem. Håll pekaren över objektet i menyraden för att se alla avläsningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移项目即可重新排序。将指针悬停在菜单栏项目上可查看所有读数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移項目即可重新排序。將指標移到選單列項目上，即可查看所有讀數。"
          }
        }
      }
    },
    "Drag the floating window anywhere. Hover over it to close it, or right-click it for more." : {
      "comment" : "Settings footnote under the floating window options.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب النافذة العائمة إلى أي مكان. مرّر المؤشر فوقها لإغلاقها، أو انقر عليها بزر الماوس الأيمن لمزيد من الخيارات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk det svævende vindue hen, hvor du vil. Hold markøren over det for at lukke det, eller højreklik for flere valg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe das Schwebefenster an eine beliebige Stelle. Bewege den Mauszeiger darauf, um es zu schließen, oder klicke mit der rechten Maustaste für weitere Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la ventana flotante adonde quieras. Pasa el puntero por encima para cerrarla o haz clic derecho para ver más opciones."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la ventana flotante a cualquier lugar. Coloca el cursor sobre ella para cerrarla, o haz clic derecho para ver más opciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä kelluva ikkuna minne tahansa. Sulje se viemällä osoitin sen päälle tai napsauta sitä hiiren kakkospainikkeella nähdäksesi lisää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la fenêtre flottante où vous voulez. Survolez-la pour la fermer, ou faites un clic droit dessus pour plus d’options."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la fenêtre flottante où vous voulez. Placez le pointeur dessus pour la fermer, ou faites un clic droit pour plus d’options."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גררו את החלון הצף לכל מקום. העבירו מעליו את המצביע כדי לסגור אותו, או לחצו עליו לחיצה ימנית לאפשרויות נוספות."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la finestra fluttuante dove vuoi. Passaci sopra con il puntatore per chiuderla, oppure fai clic con il tasto destro per altre opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フローティングウインドウは好きな場所にドラッグできます。ポインタを合わせると閉じることができ、右クリックするとその他の操作が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플로팅 윈도우를 원하는 곳으로 드래그하세요. 포인터를 올리면 닫을 수 있고, 오른쪽 클릭하면 더 많은 옵션을 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra det flytende vinduet hvor som helst. Hold pekeren over det for å lukke det, eller høyreklikk på det for flere valg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep het zwevende venster waar je maar wilt. Beweeg de aanwijzer erover om het te sluiten, of klik met de rechtermuisknop voor meer opties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a janela flutuante para qualquer lugar. Passe o ponteiro sobre ela para fechá-la ou clique nela com o botão direito para ver mais opções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a janela flutuante para onde quiser. Passe o cursor sobre ela para a fechar ou clique com o botão direito para ver mais opções."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra det flytande fönstret vart du vill. Håll pekaren över det för att stänga det, eller högerklicka på det för fler alternativ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可将悬浮窗口拖移到任意位置。将指针悬停在其上可将其关闭，点按右键可查看更多选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可將浮動視窗拖移到任何位置。將指標移到視窗上即可關閉，或按一下滑鼠右鍵查看更多選項。"
          }
        }
      }
    },
