    "When off, Fanny stops reading the CPU temperature." : {
      "comment" : "Settings subtitle under the CPU Temperature switch: turning it off stops the reading entirely (keep Fanny).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، يتوقف Fanny عن قراءة حرارة CPU."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er slået fra, holder Fanny op med at aflæse CPU-temperaturen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ausgeschaltet, liest Fanny die CPU-Temperatur nicht mehr aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivada, Fanny deja de leer la temperatura de la CPU."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se desactiva, Fanny deja de leer la temperatura de la CPU."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun asetus on pois päältä, Fanny lopettaa CPU:n lämpötilan lukemisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si désactivé, Fanny cesse de lire la température du CPU."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque désactivée, Fanny cesse de lire la température du CPU."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפשרות כבויה, Fanny מפסיקה לקרוא את טמפרטורת ה-CPU."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivata, Fanny smette di leggere la temperatura della CPU."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、FannyはCPU温度の読み取りを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 Fanny가 CPU 온도 읽기를 중단해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er av, slutter Fanny å lese CPU-temperaturen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uit staat, leest Fanny de CPU-temperatuur niet meer uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, o Fanny deixa de ler a temperatura da CPU."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativada, o Fanny deixa de ler a temperatura da CPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När den är av slutar Fanny läsa av CPU-temperaturen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后，Fanny 将停止读取 CPU 温度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後，Fanny 會停止讀取 CPU 溫度。"
          }
        }
      }
    },
