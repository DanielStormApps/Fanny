    "Send anonymous crash reports to help fix problems. Requires restarting Fanny to take effect." : {
      "comment" : "Settings, Privacy: subtitle of the Crash Reports switch (keep Fanny).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال تقارير أعطال مجهولة للمساعدة في إصلاح المشكلات. يتطلب إعادة تشغيل Fanny ليسري."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send anonyme nedbrudsrapporter for at hjælpe med at rette problemer. Kræver, at Fanny genstartes, før det træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende anonyme Absturzberichte, um bei der Behebung von Problemen zu helfen. Fanny muss dafür neu gestartet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía informes de fallos anónimos para ayudar a corregir problemas. Requiere reiniciar Fanny para que surta efecto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía informes de fallas anónimos para ayudar a corregir problemas. Requiere reiniciar Fanny para que surta efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä anonyymeja kaatumisraportteja ongelmien korjaamiseksi. Edellyttää Fannyn uudelleenkäynnistystä, jotta muutos tulee voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie des rapports d’incident anonymes pour aider à corriger les problèmes. Nécessite de redémarrer Fanny pour prendre effet."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des rapports de plantage anonymes pour aider à corriger les problèmes. Fanny doit être redémarrée pour que ce réglage prenne effet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שליחת דוחות קריסה אנונימיים כדי לעזור לתקן בעיות. נדרשת הפעלה מחדש של Fanny כדי שהשינוי ייכנס לתוקף."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia rapporti anonimi sugli arresti anomali per aiutare a risolvere i problemi. Richiede il riavvio di Fanny per avere effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題の修正に役立てるため、匿名のクラッシュレポートを送信します。反映するにはFannyの再起動が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제를 해결하는 데 도움이 되도록 익명 충돌 보고서를 보냅니다. 적용하려면 Fanny를 다시 시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send anonyme krasjrapporter for å hjelpe med å rette problemer. Krever at Fanny startes på nytt for å tre i kraft."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuur anonieme crashrapporten om problemen te helpen oplossen. Fanny moet opnieuw worden gestart om dit door te voeren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie relatórios de falhas anônimos para ajudar a corrigir problemas. É necessário reiniciar o Fanny para a mudança ter efeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie relatórios de falhas anónimos para ajudar a corrigir problemas. Requer reiniciar o Fanny para ter efeito."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka anonyma kraschrapporter för att hjälpa till att rätta problem. Kräver att Fanny startas om för att gälla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送匿名崩溃报告以帮助修复问题。需要重新启动 Fanny 才会生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送匿名當機報告，協助修正問題。需要重新啟動 Fanny 才會生效。"
          }
        }
      }
    },
