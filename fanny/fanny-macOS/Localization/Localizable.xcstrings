    "Help keep Fanny free for everyone by downloading my other app Positive." : {
      "comment" : "Settings subtitle asking the user to download Positive, the developer's other app (keep Fanny and Positive).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعد في إبقاء Fanny مجانيًا للجميع بتنزيل تطبيقي الآخر Positive."
          }
        },
        "da" : {
